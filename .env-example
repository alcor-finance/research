# Скопируйте в .env и заполните:
# cp .env-example .env
# bash simple_aave_uni_vault/scripts/run_all.sh

# ---- REQUIRED ----
# Fork params
FORK_BLOCK=21900000
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Roles (по умолчанию depositor=SAFE_OWNER_1, manager=ZODIAC_MANAGER)
SAFE_OWNER_1=0xYOUR_DEPOSITOR_EOA_ADDRESS
ZODIAC_MANAGER=0xYOUR_MANAGER_EOA_ADDRESS

# Assets / protocols (mainnet)
# Заполните РЕАЛЬНЫМИ адресами выбранной сети (обычно Ethereum mainnet).
WBTC_TOKEN=0xYOUR_WBTC_TOKEN_ADDRESS
WBTC_WHALE=0xYOUR_WBTC_HOLDER_AT_FORK_BLOCK
AAVE_POOL_ADDRESS=0xYOUR_AAVE_POOL_ADDRESS
AAVE_COLLATERAL_ASSET_WBTC=0xYOUR_COLLATERAL_TOKEN_ADDRESS
AAVE_BORROW_ASSET_USDC=0xYOUR_BORROW_TOKEN_ADDRESS
UNISWAP_V3_SWAP_ROUTER=0xYOUR_UNISWAP_V3_ROUTER_ADDRESS

# Access-control check target (адрес для whitelist-проверки manager withdraw)
WHITELIST_6TH_WALLET_ADDRESS=0xYOUR_WHITELIST_RECIPIENT_ADDRESS

# ---- OPTIONAL (defaults are in scripts) ----
# ANVIL_RPC_URL=http://127.0.0.1:8545
# ENV_FILE=./configs/my.env              # можно передать альтернативный env при запуске
# DEPLOYER_PK=0xYOUR_PRIVATE_KEY
# DEPOSITOR_ADDRESS=0xYOUR_DEPOSITOR_OVERRIDE
# MANAGER_ADDRESS=0xYOUR_MANAGER_OVERRIDE
# SAFE_OWNER_2=0xYOUR_SECONDARY_OWNER_ADDRESS
# FUND_ETH_TO_VAULT=5
# FUND_WBTC_TO_VAULT=1.5
# SUPPLY_WBTC=0.25
# BORROW_USDC=3000
# SWAP_USDC_IN=500
# MANAGER_WITHDRAW_USDC=100
# DEPOSITOR_WITHDRAW_USDC=50
# NON_WHITELIST_ADDRESS=0x1111111111111111111111111111111111111111
# DEPOSITOR_WITHDRAW_TARGET=0xYOUR_WITHDRAW_TARGET
